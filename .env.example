# Root env template. Copy to backend/.env (and frontend/.env.local once that
# workspace exists). Vars are grouped by the phase that introduces them —
# see BACKEND_PLAN.md. Phase 0 + Phase 1 + Phase 2 groups are read/validated.

# --- Phase 0 (foundation) ---------------------------------------------------
NODE_ENV=development
API_PORT=4000
API_CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/society_fintech?schema=public

# --- Phase 1 (auth + job blog) ----------------------------------------------
# DB-backed sessions (not JWT) — see SUPERVISOR.md decisions log.
SESSION_COOKIE_NAME=sid
SESSION_TTL_DAYS=30
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@societyfintech.local
# Used to build absolute links inside emails (company-email verification).
API_BASE_URL=http://localhost:4000

# --- Phase 2 (vendor marketplace) -------------------------------------------
# GSTIN verification at vendor onboarding. Off by default: dev and all tests
# use a deterministic offline stub (see infra/gstinapi/), so no key is needed
# to run the app or the suite. Set GSTIN_API_ENABLED=true + a real key to hit
# the live gstinapi.in free tier. Truthy values: "true" / "1".
GSTIN_API_ENABLED=false
GSTIN_API_URL=https://gstinapi.in/api/v1/gstin
GSTIN_API_KEY=

# --- Phase 4B (Razorpay sandbox) --------------------------------------------
# Off by default: dev and all automated tests run RazorpayService against a
# deterministic in-memory stub (see backend/src/infra/razorpay/), so no real
# key is needed to run the app or the suite. Webhook signature verification
# is REAL HMAC-SHA256 even when disabled — only "did Razorpay charge a card"
# is faked. Set RAZORPAY_ENABLED=true + real test-mode keys to hit the actual
# Razorpay sandbox. Truthy values: "true" / "1".
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=rzp_test_stub
RAZORPAY_KEY_SECRET=stub_secret
RAZORPAY_WEBHOOK_SECRET=stub_webhook_secret

# --- Phase 6.2 (identity: phone OTP + officer/vendor password+TOTP 2FA) ----
# Off by default: dev and all automated tests run SmsService against a
# deterministic offline stub (see backend/src/infra/sms/), so no real SMS
# gateway account is needed to run the app or the suite. Unlike
# RAZORPAY_ENABLED, there is no real-gateway code path in this phase at
# all — flipping this on throws rather than sending anything real.
SMS_ENABLED=false
# Issuer name shown in an authenticator app when a committee officer/vendor
# enrolls TOTP 2FA (SDD §5.1 / DECISIONS_V2_SCOPE.md §7.2).
TOTP_ISSUER=Society FinTech

# --- Simulation read-back — not yet read by config/ -------------------------
# SIMULATION_OUTPUTS_DIR=../simulation/outputs
