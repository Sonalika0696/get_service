// Prisma schema — Society FinTech Platform
// Tracks DESIGN.md v0.4 / ARCHITECTURE.md v0.2.
// Phase 0 scope: User, Society, Flat, Occupancy, Role, AuditLog (hash-chained).
// Later phases extend this file; see BACKEND_PLAN.md for the full entity list.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & tenancy
// ---------------------------------------------------------------------------

enum KycTier {
  NONE
  LIGHT
  STANDARD
}

/// Discriminates the three authentication surfaces (Phase 6.2 — see
/// BACKEND_PLAN.md Phase 6 and DECISIONS_V2_SCOPE.md §7.4). RESIDENT
/// authenticates by phone OTP and is scoped to an Occupancy; VENDOR and
/// OPERATOR authenticate by password + mandatory TOTP 2FA (§7.2) and are
/// resolved by UserContextService without needing an Occupancy at all —
/// previously the absence of one made a vendor/operator's login a 401
/// regardless of kind.
enum PrincipalKind {
  RESIDENT
  VENDOR
  OPERATOR
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  phone           String?   @unique
  kycTier         KycTier   @default(NONE)
  emailVerifiedAt DateTime?
  /// Set the first time a phone-OTP verify() succeeds for this user. Phone
  /// is the resident credential anchor (DECISIONS_V2_SCOPE.md §7.1); email
  /// stays a required contact field, not flipped to optional in 6.2 — see
  /// the officer/vendor auth doc comments for why the two channels are kept
  /// deliberately separate rather than unified.
  phoneVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  /// Defaults to RESIDENT so every pre-6.2 row (and every plain signup())
  /// keeps working with no backfill. VENDOR/OPERATOR rows are provisioned
  /// directly (no self-serve signup route in 6.2 — see officer-auth.service.ts).
  principalKind PrincipalKind @default(RESIDENT)

  /// VENDOR principals only: the one Vendor identity this login is for (and,
  /// transitively, its linked societies — see UserContextService.load()).
  /// Null for RESIDENT/OPERATOR. Phase 7.1 split Vendor from
  /// VendorSocietyLink: one User <-> one Vendor <-> many VendorSocietyLink,
  /// so a vendor may now serve multiple societies (see VendorPrincipal's
  /// `societyIds`).
  vendorId String? @unique

  /// Password + mandatory TOTP 2FA path for VENDOR/OPERATOR principals
  /// (SDD §5.1 / DECISIONS_V2_SCOPE.md §7.2) — a credential path separate
  /// from resident phone OTP. All three null until enrollment completes;
  /// totpEnabledAt is only set once a real TOTP code has been verified
  /// against totpSecret (see OfficerAuthService.enrollVerifyTotp), so
  /// "has a passwordHash but not totpEnabledAt" is a legitimate mid-enrollment
  /// state that OfficerAuthService.login refuses to log in.
  passwordHash  String?
  totpSecret    String?
  totpEnabledAt DateTime?

  occupancies           Occupancy[]           @relation("OccupancyResident")
  delegatedOccupancies  Occupancy[]           @relation("OccupancyDelegate")
  /// Phase 6.3: occupancies this user (a committee/treasurer officer)
  /// ratified or rejected — see RatificationStatus.
  ratifiedOccupancies   Occupancy[]           @relation("OccupancyRatifiedBy")
  /// Phase 6.3: Delegation grants where this user is the DELEGATE (the
  /// person receiving delegated rights, e.g. a tenant). The other side —
  /// whose occupancy is delegating — is reached via Delegation.occupancy.
  delegationsReceived   Delegation[]          @relation("DelegationDelegate")
  /// Phase 6.3: ConsentGrant rows this user has GIVEN (they are the data
  /// subject / grantor).
  consentsGranted       ConsentGrant[]        @relation("ConsentGrantor")
  /// Phase 6.3: ConsentGrant rows naming this user as the GRANTEE (they are
  /// the one who may see the consented data — e.g. a vendor's linked User).
  consentsReceived      ConsentGrant[]        @relation("ConsentGrantee")
  roles                 Role[]
  sessions              Session[]
  otps                  Otp[]
  jobBlogPosts          JobBlogPost[]
  vendorRatings         VendorRating[]
  vendorAccessRequests  VendorAccessRequest[]
  kycDocuments          KycDocument[]
  raisedServiceRequests ServiceRequest[]
  participations        Participation[]
  payments              Payment[]
  bulkBuyCommitments    Commitment[]
  jobCards              JobCard[]
  vendor                Vendor?               @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@map("users")
}

/// Opaque bearer token in the session cookie; only its SHA-256 hash is
/// stored so a DB read alone can't produce a valid session (DB-backed
/// sessions chosen over stateless JWT specifically so logout/revoke works —
/// see SUPERVISOR.md decisions log).
model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  userAgent  String?
  ip         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// 6-digit email OTP, used for both signup verification and login (no
/// passwords in v1). Only the SHA-256 hash of the code is stored.
model Otp {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("otps")
}

/// Phase 6.3 society lifecycle (BACKEND_PLAN.md Phase 6.3 item 1). ACTIVE is
/// the only state that matters operationally today — ARCHIVED exists so an
/// operator can retire a society (e.g. decommissioned client) without a
/// destructive delete, matching how VerificationTier/PollStatus/etc. model
/// forward-only lifecycle rather than hard deletes elsewhere in this schema.
enum SocietyStatus {
  ACTIVE
  ARCHIVED
}

model Society {
  id            String        @id @default(cuid())
  name          String
  address       String
  latitude      Float?
  longitude     Float?
  /// Society-level feature/config toggles (e.g. job-post rate limit). Phase
  /// 6.4 (BACKEND_PLAN.md Phase 6.4, M14) adds an `approval` sub-object here:
  /// `{ approval: { lowerThreshold, upperThreshold, majorityFraction } }` —
  /// the per-society bulk-buy payout/milestone approval-ladder thresholds.
  /// See approval-ladder.util.ts's doc comment for the shape, validation and
  /// documented defaults used when this key is absent or malformed.
  config        Json          @default("{}")
  /// Phase 6.3: operator-managed lifecycle state. ARCHIVED societies are
  /// excluded from the operator's default listing but not deleted — see
  /// SocietyService.archive's doc comment.
  status        SocietyStatus @default(ACTIVE)
  /// Cached tail hash of this society's AuditLog chain — see AuditService.
  /// Null means the chain hasn't been written to yet (genesis pending).
  auditTailHash Bytes?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  flats           Flat[]
  roles           Role[]
  auditLogs       AuditLog[]
  jobBlogPosts    JobBlogPost[]
  /// Phase 7.1: goes through VendorSocietyLink now, not a direct Vendor.societyId FK — see VendorSocietyLink's doc comment.
  vendorLinks     VendorSocietyLink[]
  serviceRequests ServiceRequest[]
  accounts        Account[]
  ledgerEntries   LedgerEntry[]
  payments        Payment[]
  offers          Offer[]
  bookings        Booking[]
  /// Phase 9.1 — see VirtualAccount's doc comment.
  virtualAccounts VirtualAccount[]

  @@map("societies")
}

model Flat {
  id                String   @id @default(cuid())
  societyId         String
  unitNo            String
  maintenanceAmount Decimal  @db.Decimal(10, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  society               Society          @relation(fields: [societyId], references: [id], onDelete: Cascade)
  occupancies           Occupancy[]
  bulkBuyCommitments    Commitment[]
  jobCards              JobCard[]
  participations        Participation[]
  /// Phase 8.2 — service requests raised for this flat (see ServiceRequest.raisedByFlatId).
  raisedServiceRequests ServiceRequest[]
  /// Phase 9.1 — this flat's one attribution key (see VirtualAccount's doc comment). Lazily provisioned; may be null for a flat older than this phase until backfilled.
  virtualAccount        VirtualAccount?

  @@unique([societyId, unitNo])
  @@map("flats")
}

/// OWNER_OCCUPIER: owns and lives in the flat.
/// OWNER_ABSENTEE: owns but doesn't live there; may delegate operational
///   rights (service requests, bulk-buy) to the tenant via delegatedToUserId.
///   Retains financial/governance rights regardless of delegation.
/// TENANT: rents; no lending/binding-vote rights.
enum OccupancyRole {
  OWNER_OCCUPIER
  OWNER_ABSENTEE
  TENANT
}

/// Phase 6.3 committee ratification queue (DECISIONS_V2_SCOPE.md §7.3, SDD
/// §5.3 phantom-resident threat). PENDING is the default for every
/// self-registered occupancy (AuthService.signup) — UserContextService.load
/// treats a PENDING/REJECTED occupancy as no occupancy at all, so an
/// un-ratified resident cannot authenticate as RESIDENT on any route (see
/// UserContextService's doc comment). An occupancy created directly by a
/// trusted party (committee/operator move-in — OccupancyService.moveIn) is
/// stamped RATIFIED immediately: the phantom-resident threat is specifically
/// about a SELF-registered account nobody has vetted, not every occupancy.
enum RatificationStatus {
  PENDING
  RATIFIED
  REJECTED
}

model Occupancy {
  id                String        @id @default(cuid())
  flatId            String
  userId            String
  role              OccupancyRole
  /// Only meaningful when role = OWNER_ABSENTEE: the tenant this owner has
  /// delegated operational rights to. Superseded in practice by the Phase
  /// 6.3 `Delegation` entity (scoped, revocable, audit-logged) — retained,
  /// unused by any guard, for backward compatibility with existing rows and
  /// the Prisma column; see Delegation's doc comment for the full decision.
  delegatedToUserId String?
  tenureStartedAt   DateTime      @default(now())
  tenureEndedAt     DateTime?

  /// Phase 6.3 ratification queue — see RatificationStatus's doc comment.
  ratificationStatus    RatificationStatus @default(PENDING)
  /// Set once a COMMITTEE/TREASURER officer ratifies or rejects (both use
  /// this same timestamp field; ratificationStatus disambiguates which).
  ratificationDecidedAt DateTime?
  ratifiedByUserId      String?
  /// Free-text reason, required on reject, optional on ratify — see
  /// RatificationDto.
  ratificationNote      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  flat        Flat         @relation(fields: [flatId], references: [id], onDelete: Cascade)
  user        User         @relation("OccupancyResident", fields: [userId], references: [id], onDelete: Cascade)
  delegatedTo User?        @relation("OccupancyDelegate", fields: [delegatedToUserId], references: [id], onDelete: SetNull)
  ratifiedBy  User?        @relation("OccupancyRatifiedBy", fields: [ratifiedByUserId], references: [id], onDelete: SetNull)
  delegations Delegation[]

  @@index([flatId])
  @@index([userId])
  @@index([ratificationStatus])
  @@map("occupancies")
}

/// Society-level roles layered on top of an occupancy (committee, treasurer).
/// Distinct from OccupancyRole, which is owner-vs-tenant on a specific flat.
enum RoleKind {
  COMMITTEE
  TREASURER
  DEPUTY_TREASURER
}

model Role {
  id        String   @id @default(cuid())
  societyId String
  userId    String
  kind      RoleKind
  createdAt DateTime @default(now())

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([societyId, userId, kind])
  @@map("roles")
}

// ---------------------------------------------------------------------------
// Delegation — Phase 6.3 (DECISIONS_V2_SCOPE.md §7.3 area; DESIGN.md's
// entity table). Scoped, explicit, revocable delegation of OPERATIONAL
// rights from one occupancy to another user (e.g. an owner-absentee
// delegating to their tenant). Complements rather than replaces
// Occupancy.delegatedToUserId — see that field's doc comment: the old column
// is an unstructured single pointer with no scope, no revocation trail and
// (checked across every controller in this repo) no guard anywhere actually
// reads it today, so nothing breaks by leaving it in place unused. Delegation
// is the real, auditable mechanism: multiple scoped grants per occupancy,
// each independently revocable, each an audit-logged event (DesignDoc:
// "delegations and consents are logged, revocable events enforced at query
// time").
//
// DelegationScope deliberately cannot express money or governance actions —
// this is enforced AT THE TYPE LEVEL: the enum below has no MONEY/PAYOUT/
// LEDGER/VOTE/APPROVAL member and structurally cannot be extended to include
// one without a schema migration reviewers would see. Compare this to a
// string/bitmask scope, which a caller could smuggle "PAYOUT" into and a
// runtime check would have to reject — that failure mode isn't possible
// here. (SDD: "financial and voting capabilities excluded from the
// delegable set at the type level".)
// ---------------------------------------------------------------------------

enum DelegationScope {
  /// Raise/join a ServiceRequest-equivalent (today: Poll/Offer commitments, bulk-buy).
  SERVICE_REQUESTS
  /// Opt in to society events on the delegating occupancy's behalf.
  EVENT_OPT_IN
  /// Post to the job blog / notice board as the delegating occupancy.
  JOB_BLOG_POSTING
  /// Request access to a vendor's contact details via the directory.
  VENDOR_DIRECTORY_ACCESS
}

/// One row per (occupancy, delegate, scope) grant. A delegate with several
/// scopes holds several rows — never a bitmask — so each is independently
/// revocable and each revocation is its own auditable event.
model Delegation {
  id             String          @id @default(cuid())
  occupancyId    String
  delegateUserId String
  scope          DelegationScope
  grantedAt      DateTime        @default(now())
  revokedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  occupancy Occupancy @relation(fields: [occupancyId], references: [id], onDelete: Cascade)
  delegate  User      @relation("DelegationDelegate", fields: [delegateUserId], references: [id], onDelete: Cascade)

  @@unique([occupancyId, delegateUserId, scope])
  @@index([delegateUserId])
  @@map("delegations")
}

// ---------------------------------------------------------------------------
// ConsentGrant — Phase 6.3. Enforced AT QUERY TIME, not at display time: see
// VendorsService.getResidentContact (vendors.service.ts) for the reference
// implementation — the consent check is embedded in the Prisma `where`
// clause of the query that fetches the data (a relational `some` filter on
// consentsGranted), so a caller lacking consent gets a query that returns no
// row at all, indistinguishable from the resident not existing. This is
// deliberately NOT "fetch the resident, then check consent, then decide
// whether to return the phone/email fields" — that shape is a display-time
// filter, exactly what DESIGN.md's entity table rules out.
// ---------------------------------------------------------------------------

enum ConsentPurpose {
  /// Grantee may see the grantor's phone/email via the vendor-contact route.
  CONTACT_INFO
}

model ConsentGrant {
  id            String         @id @default(cuid())
  /// The data subject granting consent (today: always a RESIDENT).
  userId        String
  /// Who may access the consented data (today: a VENDOR-principal User).
  granteeUserId String
  purpose       ConsentPurpose
  grantedAt     DateTime       @default(now())
  revokedAt     DateTime?

  createdAt DateTime @default(now())

  user    User @relation("ConsentGrantor", fields: [userId], references: [id], onDelete: Cascade)
  grantee User @relation("ConsentGrantee", fields: [granteeUserId], references: [id], onDelete: Cascade)

  @@unique([userId, granteeUserId, purpose])
  @@index([granteeUserId])
  @@map("consent_grants")
}

// ---------------------------------------------------------------------------
// Audit — append-only, hash-chained. No module should ever update or delete
// a row here. See AuditService for the chain-append and chain-verify logic
// (DESIGN.md §1a.4 — one of the dissertation's four novelty claims).
// ---------------------------------------------------------------------------

model AuditLog {
  id       String   @id @default(cuid())
  /// Global auto-increment, used to order the per-society chain
  /// (society-scoped WHERE + ORDER BY sequence gives a stable causal order).
  sequence Int      @default(autoincrement())
  ts       DateTime @default(now())

  societyId   String
  actorId     String?
  action      String
  subjectType String
  subjectId   String
  payload     Json

  /// entryHash of the previous row in this society's chain (32 zero bytes
  /// for the genesis row).
  previousHash Bytes
  /// SHA-256(previousHash || canonicalJson({ts, societyId, actorId, action,
  /// subjectType, subjectId, payload})).
  entryHash    Bytes

  society Society @relation(fields: [societyId], references: [id], onDelete: Restrict)

  @@index([subjectType, subjectId])
  @@index([actorId])
  @@index([societyId, sequence])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Job blog — Phase 1's referral surface.
// ---------------------------------------------------------------------------

enum JobBlogKind {
  HIRING
  SEEKING
}

enum JobBlogStatus {
  ACTIVE
  FLAGGED
  REMOVED
}

model JobBlogPost {
  id        String        @id @default(cuid())
  societyId String
  posterId  String
  kind      JobBlogKind
  title     String
  body      String
  status    JobBlogStatus @default(ACTIVE)
  /// Set at creation to createdAt + 60 days. A post is only publicly listed
  /// while status = ACTIVE *and* expiresAt is in the future — checked at
  /// query time rather than flipped by a cron (see SUPERVISOR.md decisions).
  expiresAt DateTime

  /// HIRING posts only — SEEKING posts leave these null and are visible
  /// immediately (no employer to impersonate).
  companyEmail               String?
  companyEmailVerifiedAt     DateTime?
  companyEmailTokenHash      String?
  companyEmailTokenExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  poster  User    @relation(fields: [posterId], references: [id], onDelete: Cascade)

  @@index([societyId, status, expiresAt])
  @@index([posterId, createdAt])
  @@map("job_blog_posts")
}

// ---------------------------------------------------------------------------
// Vendor marketplace — Phase 2. Society-scoped vendor directory with a
// committee-driven onboarding/approval flow, resident ratings, and a light
// access-request trail. See src/modules/vendors for the service layer and
// src/infra/gstinapi for the (feature-flagged, stubbable) GSTIN lookup used
// during approval.
// ---------------------------------------------------------------------------

/// UNVERIFIED: just onboarded by a committee member, no external check yet.
/// SOCIETY_ATTESTED: the vendor's GSTIN came back Active from the GSTIN
///   lookup at approval time — the society is vouching for it.
/// PLATFORM_AUDITED: a stronger, platform-level audit. Phase 7.3
///   (BACKEND_PLAN.md Phase 7 item 8) implements the promotion itself as an
///   OPERATOR-only manual action (POST /operator/vendors/:vendorId/promote)
///   — there is still no automated audit pipeline behind it, only the tier
///   and the guard that a vendor must already be SOCIETY_ATTESTED with a
///   GSTIN or trade licence on file before an operator can promote it.
/// Transitions are forward-only: UNVERIFIED -> SOCIETY_ATTESTED -> PLATFORM_AUDITED.
enum VerificationTier {
  UNVERIFIED
  SOCIETY_ATTESTED
  PLATFORM_AUDITED
}

enum RatingSource {
  RESIDENT
  COMMITTEE
}

/// Phase 7.1 (BACKEND_PLAN.md Phase 7 item 1; DECISIONS_V2_SCOPE.md §7.6):
/// Vendor is the vendor's GLOBAL identity — name, contact, geo, GSTIN, and
/// the single global rating aggregate. It no longer carries a societyId: a
/// vendor's presence in a given society is a VendorSocietyLink row, and one
/// Vendor can now have many links (many societies). verificationTier stays
/// here as the vendor's global tier for now — untouched by this split;
/// refining it into per-society SOCIETY_ATTESTED semantics is Phase 7.3's
/// job, not this one's.
model Vendor {
  id           String   @id @default(cuid())
  name         String
  contactEmail String?
  contactPhone String?
  latitude     Float?
  longitude    Float?
  /// Service radius in km, used later for proximity search — optional until then.
  radiusKm     Decimal? @db.Decimal(6, 2)

  verificationTier VerificationTier @default(UNVERIFIED)
  gstin            String?
  gstinVerifiedAt  DateTime?

  /// Phase 7.3 (BACKEND_PLAN.md Phase 7 item 7): trade licence capture
  /// alongside the existing GSTIN. Mirrors gstin/gstinVerifiedAt's shape —
  /// captured now via the vendor's own profile self-service; there is no
  /// registry-lookup integration in this phase (unlike gstinApi for GSTIN),
  /// so tradeLicenceVerifiedAt is a manual/stubbed field nothing in this
  /// phase sets automatically.
  tradeLicenceNumber     String?
  tradeLicenceVerifiedAt DateTime?

  /// Phase 7.3 (BACKEND_PLAN.md Phase 7 item 6): the vendor's own
  /// self-declared payout destination for a future (still-stubbed)
  /// RazorpayX settlement — see Payout.razorpayPayoutRef's doc comment for
  /// how stubbed the actual money movement remains. This is metadata the
  /// vendor supplies about ITS OWN account via an authenticated route, not a
  /// credential and not something this phase verifies or moves money
  /// against — VendorsService never logs settlementAccountNumber (pino's
  /// default request logging doesn't include the body either — see
  /// app.module.ts's pinoHttp config). Never exposed through the
  /// resident/committee-facing VendorDetail shape — see
  /// VendorsService.toDetail's doc comment.
  settlementAccountName   String?
  settlementAccountNumber String?
  settlementIfsc          String?

  /// Denormalized GLOBAL rating aggregate, lazily recomputed by
  /// VendorsService whenever a new VendorRating is created (see rate())
  /// rather than computed on every read. Unaffected by the Phase 7.1 split
  /// — ratings are still keyed on vendorId, not on any one society.
  ratingAvg   Decimal @default(0) @db.Decimal(3, 2)
  ratingCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  societyLinks                VendorSocietyLink[]
  categories                  VendorCategory[]
  ratings                     VendorRating[]
  accessRequests              VendorAccessRequest[]
  offers                      Offer[]
  bookings                    Booking[]
  /// Phase 5 — service requests where a resident tagged this vendor for a Flow B bulk-buy (see ServiceRequest.taggedVendorId).
  assignedServiceRequests     ServiceRequest[]      @relation("ServiceRequestTaggedVendor")
  /// Phase 8.2 — service requests a committee member assigned this vendor to in the new pooling loop (see ServiceRequest.assignedVendorId).
  poolAssignedServiceRequests ServiceRequest[]      @relation("ServiceRequestAssignedVendor")
  /// Phase 6.2 — the VENDOR-principal User that logs in as this vendor (see User.vendorId). Opposite side of a 1:1; the FK lives on User.
  linkedUser                  User?
  /// Phase 7.2 — this vendor's published price sheets (see PricingCard).
  pricingCards                PricingCard[]

  @@map("vendors")
}

/// Phase 7.1: a Vendor's presence/membership in one Society — the entity the
/// Phase 6.2 doc comments on User.vendorId/VendorPrincipal already flagged
/// as coming. Every vendor↔society validation that used to compare
/// `vendor.societyId === societyId` becomes "does a VendorSocietyLink exist
/// for (vendorId, societyId)" — see BulkBuyService.createOffer/
/// createResidentPoll and VendorsService.getInternal.
model VendorSocietyLink {
  id        String   @id @default(cuid())
  vendorId  String
  societyId String
  createdAt DateTime @default(now())

  vendor  Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@unique([vendorId, societyId])
  @@index([societyId])
  @@map("vendor_society_links")
}

model VendorCategory {
  id       String @id @default(cuid())
  vendorId String
  category String

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, category])
  @@map("vendor_categories")
}

model VendorRating {
  id         String       @id @default(cuid())
  vendorId   String
  residentId String
  /// Real job cards land in a later phase (job-card lifecycle) — until then
  /// this stays null and ratings aren't gated on a completed, signed-off job.
  jobCardId  String?
  rating     Int
  comment    String?
  source     RatingSource @default(RESIDENT)
  createdAt  DateTime     @default(now())

  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  resident User   @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("vendor_ratings")
}

model VendorAccessRequest {
  id         String    @id @default(cuid())
  vendorId   String
  residentId String
  purpose    String
  grantedAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  resident User   @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("vendor_access_requests")
}

enum PricingCardStatus {
  DRAFT
  PUBLISHED
}

enum PricingBasis {
  PER_VISIT
  PER_HOUR
  PER_UNIT
  PERCENTAGE
}

/// Phase 7.2 (BACKEND_PLAN.md Phase 7 items 2-5): a vendor's versioned price
/// sheet for one category.
///
/// Scoped to VENDOR IDENTITY + CATEGORY, deliberately NOT to any one
/// society: post-7.1 a vendor is a single global identity that can serve
/// many societies (VendorSocietyLink), and its pricing for "plumbing" is one
/// thing, not a different price list per society it happens to be linked
/// to. A per-society override, if ever needed, is a distinct future
/// concept layered on top of this — not built here.
///
/// Lifecycle: created DRAFT (mutable — lines may be added/edited freely via
/// PricingCardsService), then PUBLISHED exactly once via publish(), which
/// makes the card AND its lines immutable forever after (enforced in
/// PricingCardsService.assertMutable, not at the DB layer). Revising a
/// published card creates a NEW PricingCard row (version = prev + 1,
/// status DRAFT) rather than touching the old one; publishing that new
/// draft is what stamps `supersededAt` on the row it replaces (see
/// PricingCardsService.publish) — never at draft-creation time, so an
/// abandoned revision draft never orphans the live published card.
/// Superseded rows are never deleted or mutated: any engagement that froze
/// a given version keeps reading it byte-for-byte forever (DoD: all
/// versions independently retrievable).
model PricingCard {
  id            String            @id @default(cuid())
  vendorId      String
  category      String
  version       Int
  /// GST rate applicable to this card's lines, as a percentage (e.g. 18.00).
  gstRatePct    Decimal           @db.Decimal(5, 2)
  effectiveFrom DateTime
  /// Set only when a LATER version of this (vendor, category) is published — see doc comment above.
  supersededAt  DateTime?
  status        PricingCardStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  vendor                  Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  lines                   PricingLine[]
  /// Phase 8.2 — service requests that froze THIS exact version at confirm time (see ServiceRequest.frozenPricingCardId). A later revision/republish never touches these historical pointers.
  frozenByServiceRequests ServiceRequest[]

  @@unique([vendorId, category, version])
  @@index([vendorId, category])
  @@map("pricing_cards")
}

/// A single priced item on a PricingCard. The visit/callout charge is
/// modelled as an ordinary PER_VISIT line here — deliberately not a
/// separate column or an implicit fee added at engagement time, so it's
/// visible, editable and versioned exactly like every other line
/// (BACKEND_PLAN.md Phase 7 item 3).
model PricingLine {
  id         String       @id @default(cuid())
  cardId     String
  label      String
  basis      PricingBasis
  rate       Decimal      @db.Decimal(10, 2)
  minimum    Decimal?     @db.Decimal(10, 2)
  conditions String?

  card PricingCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@map("pricing_lines")
}

/// Phase-2 stub: records upload METADATA only (kind + fileName); there is no
/// real file storage or OCR/verification pipeline yet. storageRef is a fake
/// local placeholder path until an object store is wired up in a later phase.
model KycDocument {
  id         String   @id @default(cuid())
  userId     String
  kind       String
  fileName   String
  storageRef String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("kyc_documents")
}

// ---------------------------------------------------------------------------
// Poll engine — Phase 3, reduced in the V2.0 scope revision. Resident voting
// (ADVISORY/BINDING polls, Vote, weighting, quorum) is withdrawn — see
// DECISIONS_V2_SCOPE.md §2.4–2.5 and SDD invariant I8. What remains is the
// opt-in "join" mechanic: residents commit, and the poll auto-fires at its
// minimum. Phase 8 renames this to ServiceRequest/Participation.
// ---------------------------------------------------------------------------

/// EVENT: residents "join" (Participation) and the poll auto-fires once
///   minCommitments is reached. Not a vote — no choice, no weight.
/// BULK_BUY_RESIDENT: same commitment mechanics as EVENT (Participation /
///   minCommitments / auto-fire), but OWNED end-to-end by the bulk-buy
///   module (Phase 5 Flow B), not by PollsService — see
///   src/modules/bulk-buy/bulk-buy.service.ts's Flow B section and this
///   model's taggedVendorId/vendorConfirmed*/vendorDeclinedAt fields.
///   PollsService.create/join both reject this pollType with 400,
///   directing callers to the bulk-buy routes instead.
enum ServiceRequestType {
  EVENT
  BULK_BUY_RESIDENT
  /// Phase 8.2 (BACKEND_PLAN.md Phase 8 item 2): the NEW ServiceRequest
  /// pooling loop (create -> join -> threshold -> committee-assign ->
  /// committee-relayed vendor-confirm -> PricingCard freeze -> escrow),
  /// built ADDITIVELY alongside EVENT and BULK_BUY_RESIDENT — see
  /// ServiceRequestsService's class doc comment. Both RESIDENT- and
  /// COMMITTEE-origin requests (see ServiceRequestOrigin) use this same
  /// pollType; PollsService.create/join reject it with 400 (same ownership
  /// split already applied to BULK_BUY_RESIDENT), directing callers to the
  /// dedicated /service-requests routes instead.
  SERVICE_REQUEST
}

enum ServiceRequestStatus {
  OPEN
  FIRED
  EXPIRED
  CLOSED
  /// Phase 5 Flow B only: set when the tagged vendor declines via
  /// POST /bulk-buy/polls/:id/vendor-decline. No other pollType/route ever
  /// produces this status.
  CANCELLED
  /// Phase 8.2 (ServiceRequestType.SERVICE_REQUEST only): the join threshold
  /// has been met — see ServiceRequestsService.join.
  POOLED
  /// Phase 8.2: a committee member has assigned a vendor (that must already
  /// be linked to the society and hold a current PUBLISHED PricingCard for
  /// the request's category) — see ServiceRequestsService.assignVendor.
  ASSIGNED
  /// Phase 8.2: the committee has relayed the vendor's confirmation — the
  /// PricingCard is frozen, the escrow Booking/Payments exist, and this
  /// request will never fire/pool/assign again. Terminal, money-bearing state.
  CONFIRMED
  /// Phase 8.2: either the vendor declined (via the committee-relayed
  /// decline route, from ASSIGNED) or the request closed below threshold
  /// (from OPEN, past closesAt). STRUCTURAL — no Payment/escrow ever existed
  /// before CONFIRMED, so there is nothing to reverse; see
  /// ServiceRequestsService.decline / closeBelowThreshold.
  LAPSED
}

/// Phase 8.2: RESIDENT (a resident raised it for their own flat) or
/// COMMITTEE (a committee member raised it on a named flat's behalf) — see
/// ServiceRequestsService.createResident / createCommittee. Null for every
/// pre-8.2 pollType (EVENT, BULK_BUY_RESIDENT); always set for
/// ServiceRequestType.SERVICE_REQUEST.
enum ServiceRequestOrigin {
  RESIDENT
  COMMITTEE
}

/// Phase 8.1 rename (was Poll) — same table contents/semantics, see
/// @@map("service_requests"); the pollType/taggedVendorId etc. field names
/// are unchanged in this phase (Phase 8.2's concern), only the model, table
/// and enum TYPE names moved.
model ServiceRequest {
  id        String @id @default(cuid())
  societyId String
  creatorId String

  pollType ServiceRequestType

  title       String
  description String?
  /// Phase 5 Flow B (BULK_BUY_RESIDENT only): the vendor-service category the
  /// resident tagged the poll with (mirrors Offer.category). Null for every
  /// other pollType — deliberately NOT part of the original Phase 5 field
  /// list handed down for this migration, but POST /bulk-buy/polls's body
  /// requires it and it needs somewhere durable to live; added here rather
  /// than silently dropped.
  category    String?

  /// Number of Participation rows that auto-fires the poll.
  minCommitments Int?

  closesAt DateTime
  status   ServiceRequestStatus @default(OPEN)

  /// Auto-fire timestamp.
  firedAt  DateTime?
  /// Set when a poll is closed early by its creator or expired via processExpired.
  closedAt DateTime?

  /// Phase 5 Flow B (BULK_BUY_RESIDENT only): the vendor a resident tagged
  /// when opening this poll. Null for every other pollType. SetNull rather
  /// than Cascade — a deleted Vendor shouldn't take a historical poll with it.
  taggedVendorId         String?
  /// Set once a COMMITTEE member (acting for the vendor — no vendor login in
  /// v1, see bulk-buy.service.ts's class doc comment) confirms terms via
  /// POST /bulk-buy/polls/:id/vendor-confirm. Null until then.
  vendorConfirmedAt      DateTime?
  /// Set if the vendor instead declines via POST /bulk-buy/polls/:id/vendor-decline
  /// (which also flips status to CANCELLED). Mutually exclusive with vendorConfirmedAt.
  vendorDeclinedAt       DateTime?
  /// The vendor-confirmed minimum headcount — replaces the resident's
  /// proposedMinimum (stored in minCommitments) once confirmed. Fire
  /// triggers when the Participation count reaches this value.
  vendorConfirmedMinimum Int?
  /// The vendor-confirmed per-unit price (major units/rupees), snapshotted
  /// at confirm time — mirrors Offer.unitPrice.
  vendorUnitPrice        Decimal?  @db.Decimal(14, 2)
  /// Optional discount ladder the vendor confirmed, same shape/validation as
  /// Offer.discountLadder (discount-ladder.util.ts). Null means no ladder —
  /// Flow B fires at appliedDiscountPct 0 in that case.
  vendorDiscountLadder   Json?

  // -------------------------------------------------------------------
  // Phase 8.2 — the NEW ServiceRequest pooling loop
  // (ServiceRequestType.SERVICE_REQUEST only). All additive/nullable so
  // every pre-8.2 row (EVENT, BULK_BUY_RESIDENT) is completely untouched —
  // see ServiceRequestsService's class doc comment for the full lifecycle.
  // -------------------------------------------------------------------

  /// RESIDENT or COMMITTEE — see ServiceRequestOrigin's doc comment.
  origin         ServiceRequestOrigin?
  /// The flat this request was raised for: the resident's own flat
  /// (origin=RESIDENT) or a flat a committee member named explicitly
  /// (origin=COMMITTEE). SetNull rather than Cascade — a deleted Flat
  /// shouldn't take a historical request with it.
  raisedByFlatId String?

  /// The per-category join threshold, resolved from
  /// Society.config.serviceRequestThresholds (see
  /// service-request-threshold.util.ts) and FROZEN here at creation time —
  /// a later config change never moves an in-flight request's own threshold.
  threshold Int?

  /// Set by a COMMITTEE member via POST /service-requests/:id/assign —
  /// the vendor must already be linked to this society (VendorSocietyLink)
  /// and hold a current PUBLISHED PricingCard for this request's category
  /// (see ServiceRequestsService.assignVendor). SetNull rather than
  /// Cascade — a deleted Vendor shouldn't take a historical request with it.
  assignedVendorId String?
  assignedAt       DateTime?
  /// The committee member who called assignVendor. Plain string (not an FK)
  /// — same "loose actor pointer" shape as PayoutAuthorisation.authoriserId
  /// elsewhere in this schema.
  assignedByUserId String?

  /// The vendor's EXPLICIT per-flat quote at confirm time (committee-relayed
  /// — see ServiceRequestsService.confirm's doc comment for why this is
  /// never auto-summed from the frozen PricingCard's lines). Applied
  /// identically to every participating flat's escrow Payment/JobCard —
  /// mirrors Offer.unitPrice's "major units (rupees)" convention.
  vendorConfirmedContribution Decimal? @db.Decimal(14, 2)
  /// The vendor's current published PricingCard at the moment of confirm —
  /// FROZEN here permanently: a later revision/republish of that category
  /// never changes what this request already confirmed against. SetNull
  /// rather than Cascade for the same "never take history down with it"
  /// reason as assignedVendorId.
  frozenPricingCardId         String?

  /// Set the moment the join threshold is met (status flips OPEN -> POOLED).
  pooledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society            Society         @relation(fields: [societyId], references: [id], onDelete: Cascade)
  creator            User            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  taggedVendor       Vendor?         @relation("ServiceRequestTaggedVendor", fields: [taggedVendorId], references: [id], onDelete: SetNull)
  raisedByFlat       Flat?           @relation(fields: [raisedByFlatId], references: [id], onDelete: SetNull)
  assignedVendor     Vendor?         @relation("ServiceRequestAssignedVendor", fields: [assignedVendorId], references: [id], onDelete: SetNull)
  frozenPricingCard  PricingCard?    @relation(fields: [frozenPricingCardId], references: [id], onDelete: SetNull)
  participations     Participation[]
  /// Phase 5 Flow B / Phase 8.2: Commitment rows sourced from this service request once fired/confirmed (see Commitment.serviceRequestId).
  bulkBuyCommitments Commitment[]

  @@index([societyId, status])
  @@index([closesAt])
  @@index([taggedVendorId])
  @@index([assignedVendorId])
  @@index([raisedByFlatId])
  @@map("service_requests")
}

/// An EVENT "join" or a BULK_BUY_RESIDENT commitment to buy. Has its own
/// user FK — participations are not anonymous. Phase 8.1 rename (was
/// PollCommitment); flatId is new in Phase 8.1 (additive, backfilled) — the
/// resident-scoped unique below is intentionally NOT flat-keyed yet, that's
/// Phase 8.2's concern.
model Participation {
  id               String @id @default(cuid())
  serviceRequestId String
  residentId       String
  /// Phase 8.1: the flat this participation is keyed to (backfilled from the
  /// resident's occupancy at the time of joining — see the migration's
  /// backfill SQL). Additive data only in this phase.
  flatId           String

  /// Phase 8.2: the confirmed per-flat contribution, snapshotted from
  /// ServiceRequest.vendorConfirmedContribution the moment the request is
  /// CONFIRMED (see ServiceRequestsService.confirm). Null until then, and
  /// forever null for a pre-8.2 pollType (EVENT/BULK_BUY_RESIDENT), which
  /// keep using Commitment as their money record instead.
  contribution Decimal?            @db.Decimal(14, 2)
  /// Phase 8.2: ACTIVE (default — counts toward the join threshold and is
  /// carried into confirm) or LAPSED (set on every Participation of a
  /// request that closed below threshold — see
  /// ServiceRequestsService.closeBelowThreshold). Additive/default so every
  /// pre-8.2 row (and every EVENT/BULK_BUY_RESIDENT join) stays ACTIVE.
  status       ParticipationStatus @default(ACTIVE)

  createdAt DateTime @default(now())

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  resident       User           @relation(fields: [residentId], references: [id], onDelete: Cascade)
  flat           Flat           @relation(fields: [flatId], references: [id], onDelete: Cascade)

  @@unique([serviceRequestId, residentId])
  @@map("participations")
}

/// Phase 8.2 — see Participation.status's doc comment.
enum ParticipationStatus {
  ACTIVE
  LAPSED
}

// ---------------------------------------------------------------------------
// Ledger — Phase 4A. Append-only double-entry escrow ledger: the
// money-correctness bedrock the payments/bulk-buy/payouts phases (4B/4C)
// build on. See src/modules/ledger for the posting primitive
// (LedgerService.post), idempotency infrastructure, and the reconciliation
// stub. No Razorpay/payments/offers/bookings/payouts live here yet.
//
// Model: transfer-style double entry. Every LedgerEntry is ONE balanced
// transfer moving `amount` from debitAccountId to creditAccountId:
//   debitAccount.balance  -= amount
//   creditAccount.balance += amount
// So every post conserves the sum of all account balances in the closed set
// (money is neither created nor destroyed by moving it between the
// non-EXTERNAL accounts). Money entering/leaving the system crosses the
// EXTERNAL account (the PSP/bank boundary) — crediting EXTERNAL as money
// leaves the closed set, debiting it as money enters, so EXTERNAL's balance
// goes negative to represent the platform's net external claim. amount must
// be strictly > 0; debit and credit accounts must differ and share a society.
// ---------------------------------------------------------------------------

/// The ARCHITECTURE.md v0.2 account set, plus EXTERNAL (the PSP/bank
/// boundary) so Phase 4B/4C can post real money movement without a schema
/// migration. One canonical Account per [societyId, kind] in v1.
///
/// V2.0: VOUCHER, LENDING_SIM and COMMISSION_SINK are removed. No wallet or
/// lending exists, and invariant I2 forbids any platform-owned account —
/// the platform takes no commission (revenue is a vendor listing fee,
/// contracted outside the society's rails).
enum AccountKind {
  SOCIETY_MASTER
  BULK_BUY
  DISPUTE
  EXTERNAL
  /// Phase 4C: reserved vendor payable/settlement account. Not used by the
  /// v1 payout flow (which posts BULK_BUY -> EXTERNAL directly for the
  /// vendor's net share — see bulk-buy.service.ts's doc comment), but added
  /// now so a future phase that needs a real per-vendor settlement ledger
  /// doesn't require another migration.
  VENDOR
  /// Phase 4D: defect-liability retention holding account. A LARGE booking's
  /// retention share is moved here (BULK_BUY -> RETENTION) at the first
  /// milestone authorisation and held until the defect-liability period
  /// elapses, at which point it moves on (RETENTION -> EXTERNAL) — see
  /// BulkBuyService.authoriseMilestone / releaseRetention.
  RETENTION

  // -------------------------------------------------------------------
  // Phase 9.1 sub-ledger pockets (BACKEND_PLAN.md Phase 9.1;
  // DECISIONS_V2_SCOPE.md §6.1/§6.6 area) — additive only, exactly like
  // VENDOR/RETENTION above: adding an enum value creates no Account row
  // until something actually posts to it (LedgerService.getOrCreateAccount
  // is called lazily), and every existing posting path
  // (bulk-buy/payments/service-requests) is completely untouched by this
  // phase — no code here ever posts to a pocket kind yet. One Account row
  // per (societyId, kind) exactly as today; there is no per-flat Account —
  // per-flat attribution is VirtualAccount's job (see that model's doc
  // comment), not a proliferation of Account rows, which would blow up
  // verifyBalances()/assertAllBalances() (invariant I6) across every
  // society. The bills hub (a later phase) is expected to route a
  // resident's maintenance/utility/event contribution to the matching
  // pocket instead of the single BULK_BUY escrow account.
  /// Recurring monthly maintenance collections.
  MAINTENANCE
  /// Electricity charge collections (common-area / sub-metered billing).
  ELECTRICITY
  /// Water charge collections.
  WATER
  /// Society-run event fee collections (distinct from BULK_BUY, which stays
  /// the procurement-escrow pocket).
  EVENTS
  /// Welfare-fund collections/disbursements.
  WELFARE
  /// Sinking-fund (long-horizon capital reserve) collections.
  SINKING
  /// Corpus-fund collections.
  CORPUS
}

model Account {
  id        String      @id @default(cuid())
  societyId String
  kind      AccountKind
  /// Cached running balance, kept in sync with LedgerEntry rows inside the
  /// same transaction as every post (see LedgerService.post). Never the
  /// source of truth by itself — LedgerService.verifyBalances() cross-checks
  /// it against a recompute from LedgerEntry rows (analogous to
  /// AuditService.verifyChain()).
  balance   Decimal     @default(0) @db.Decimal(14, 2)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  society       Society       @relation(fields: [societyId], references: [id], onDelete: Cascade)
  debitEntries  LedgerEntry[] @relation("LedgerEntryDebitAccount")
  creditEntries LedgerEntry[] @relation("LedgerEntryCreditAccount")

  @@unique([societyId, kind])
  @@index([societyId])
  @@map("accounts")
}

/// Append-only — no module should ever update or delete a row here (see the
/// file-level doc comment above for the balance convention this enforces).
model LedgerEntry {
  id String   @id @default(cuid())
  ts DateTime @default(now())

  societyId       String
  debitAccountId  String
  creditAccountId String
  /// Always > 0 and debitAccountId != creditAccountId — enforced in
  /// LedgerService.post at the application layer (no DB CHECK constraint in
  /// v1, matching how other invariants in this schema are enforced).
  amount          Decimal @db.Decimal(14, 2)

  reasonCode       String
  /// Free-form pointer to the domain object this entry is for (e.g. a future
  /// Payment/Payout id) — no FK, since the linked entity type varies by
  /// phase and may not exist yet when this entry is written.
  linkedEntityType String?
  linkedEntityId   String?

  createdAt DateTime @default(now())

  society       Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  debitAccount  Account @relation("LedgerEntryDebitAccount", fields: [debitAccountId], references: [id])
  creditAccount Account @relation("LedgerEntryCreditAccount", fields: [creditAccountId], references: [id])

  @@index([societyId, ts])
  @@index([linkedEntityType, linkedEntityId])
  @@map("ledger_entries")
}

// ---------------------------------------------------------------------------
// VirtualAccount — Phase 9.1 (BACKEND_PLAN.md Phase 9.1;
// DECISIONS_V2_SCOPE.md §6.1/§6.6). A per-flat ATTRIBUTION KEY: a stable,
// human-referenceable identifier for one flat, used to attribute an incoming
// payment (e.g. a bank transfer whose narration a resident types by hand) to
// the right flat before that money is routed into the right AccountKind
// pocket (see AccountKind's Phase 9.1 section). `code` is designed to be
// substring-matched against raw bank-statement narration text in a later
// phase (9.5) — this phase only allocates it, it never reads bank statements
// or moves money.
//
// NOT AN AUTH CONCEPT. Per DECISIONS_V2_SCOPE.md §6.1/§6.6, a VirtualAccount
// plays NO role whatsoever in authentication or authorization: no guard
// reads it, UserContextService never branches on it, and no route's access
// decision depends on whether a flat has one, is missing one, or is
// RETIRED. It exists purely so a downstream reconciliation process has a
// stable string to match against — nothing more. Deleting/retiring a
// VirtualAccount must never be able to lock a resident out of anything.
// ---------------------------------------------------------------------------

/// ACTIVE: in normal use, may still receive attributed payments.
/// RETIRED: no longer live (e.g. the flat's code was regenerated after a
///   collision, or the flat itself is being decommissioned) — kept, not
///   deleted, so a historical bank-narration match against an old code
///   remains explainable rather than orphaned.
enum VirtualAccountStatus {
  ACTIVE
  RETIRED
}

/// One row per Flat (`flatId @unique` — see FlatsService/VirtualAccountsService
/// for the lazy, idempotent provisioning path: CSV import and the operator
/// backfill route both upsert-by-flatId, so re-running either can never
/// produce a second row for the same flat). `code` is globally unique (not
/// just per-society) because it is matched against free-text bank narration
/// with no society context available at match time — see
/// virtual-account-code.util.ts for the generation scheme.
model VirtualAccount {
  id        String               @id @default(cuid())
  societyId String
  flatId    String               @unique
  code      String               @unique
  status    VirtualAccountStatus @default(ACTIVE)
  createdAt DateTime             @default(now())

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  flat    Flat    @relation(fields: [flatId], references: [id], onDelete: Cascade)

  @@index([societyId])
  @@map("virtual_accounts")
}

/// Backs IdempotencyService.runOnce(scope, key, ...): a replayed request
/// carrying the same (scope, key) returns the stored response instead of
/// re-running the operation. `scope` is the route/operation name (e.g.
/// "LEDGER_ADJUSTMENT"); `key` is the caller-supplied Idempotency-Key header.
model IdempotencyKey {
  id             String   @id @default(cuid())
  key            String
  scope          String
  societyId      String?
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())

  @@unique([scope, key])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// Payments — Phase 4B. Razorpay sandbox integration on top of the Phase 4A
// ledger: a Payment tracks one Razorpay order end to end (CREATED at order
// creation, CAPTURED/REFUNDED as the signed webhook reports settlement).
// See src/infra/razorpay for the feature-flagged client and
// src/modules/payments for the order/webhook/refund routes. Amounts here are
// stored in MAJOR units (rupees) — Razorpay's own API speaks paise, and the
// conversion happens only at the infra/razorpay boundary (see
// RazorpayService's doc comment). No offers/bookings/job-cards/payouts
// (Phase 4C) reference this yet — linkedEntityType/linkedEntityId are plain
// nullable pointers for that phase to fill in later, same pattern as
// LedgerEntry's.
// ---------------------------------------------------------------------------

enum PaymentStatus {
  CREATED
  CAPTURED
  REFUNDED
  FAILED
}

model Payment {
  id         String  @id @default(cuid())
  societyId  String
  residentId String?

  /// Razorpay order id (order_...). One Payment per order.
  orderId   String  @unique
  /// Razorpay payment id (pay_...), set once the webhook reports a capture.
  paymentId String? @unique

  /// Major units (rupees) — see file-level doc comment.
  amount   Decimal       @db.Decimal(14, 2)
  currency String        @default("INR")
  status   PaymentStatus @default(CREATED)

  /// Free-text reason the resident is paying (e.g. "bulk-buy contribution").
  /// Phase 4C fills linkedEntityType/linkedEntityId once a concrete domain
  /// object (offer/booking/job-card) exists to point at.
  purpose          String?
  linkedEntityType String?
  linkedEntityId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society  Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  resident User?   @relation(fields: [residentId], references: [id], onDelete: SetNull)

  @@index([societyId])
  @@index([status])
  @@map("payments")
}

/// Durable audit/debug log of every webhook delivery this service has ever
/// accepted (post signature-verification) — eventId is Razorpay's own event
/// id. NOT itself the dedupe mechanism (IdempotencyService.runOnce is, keyed
/// on the same eventId) but kept so a redelivered/replayed event is visible
/// after the fact without digging through IdempotencyKey's opaque response
/// blobs.
model WebhookEvent {
  id         String   @id @default(cuid())
  eventId    String   @unique
  type       String
  payload    Json
  receivedAt DateTime @default(now())

  @@map("webhook_events")
}

// ---------------------------------------------------------------------------
// Bulk-buy Flow A — Phase 4C (SMALL) / Phase 4D (LARGE). Vendor-initiated
// bulk-buy: a committee member posts an Offer with a quantity discount
// ladder on a vendor's behalf (see src/modules/bulk-buy for the "no vendor
// login yet" assumption); residents commit; the offer auto-fires once
// minCommitments is reached, snapshotting the discount tier into one Booking
// + one JobCard per commitment; each resident's escrow-in is a Payment
// (Phase 4B) linked to their Commitment.
//
// SMALL bookings (Phase 4C; Phase 6.4 generalises the authorisation count —
// see below): once every JobCard is signed off and every Commitment is
// FUNDED, an N-officer approval ladder (1/2/committee-majority, by amount —
// see approval-ladder.util.ts) releases the full escrowed total to the
// vendor in one shot — see bulk-buy.service.ts's authorisePayout for the
// exact money flow.
//
// LARGE bookings (Phase 4D): the vendor is instead paid across an ordered
// sequence of Milestones, and a defect-liability Retention share is held
// back and released only after `retentionDays` elapses post-fire — see
// bulk-buy.service.ts's authoriseMilestone / releaseRetention. Phase 5
// (resident-initiated polls/weekly-recurring) concepts do not live here.
// ---------------------------------------------------------------------------

enum OfferStatus {
  OPEN
  FIRED
  EXPIRED
  CANCELLED
}

/// Phase 5: NONE (default, Phase 4C/4D unchanged) or WEEKLY — a WEEKLY offer
/// whose deadline has passed can be "rolled" (POST /offers/:id/roll) into a
/// fresh OPEN offer with deadline +7 days and empty commitments. See
/// BulkBuyService.rollOffer. A real scheduler would call roll automatically;
/// v1 exposes it as a committee-triggered endpoint only (same "no scheduler
/// yet" stance as PollsService.processExpired).
enum OfferRecurrence {
  NONE
  WEEKLY
}

/// PENDING: committed, escrow order created but not yet captured.
/// FUNDED: the linked Payment has been captured (see PaymentsService.applyCapture's
///   small Commitment-flip hook) — the resident's money is in escrow.
/// CANCELLED: not used by Flow A's happy path; reserved for a future
///   cancel/withdraw route.
enum CommitmentStatus {
  PENDING
  FUNDED
  CANCELLED
}

enum BookingStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum JobCardStatus {
  PENDING
  SIGNED_OFF
  DISPUTED
}

/// Only SMALL is produced by Flow A (Phase 4C). LARGE is reserved for Phase
/// 4D's large-job milestone/defect-retention flow — out of scope here.
enum JobCardTier {
  SMALL
  LARGE
}

enum PayoutStatus {
  PENDING
  AUTHORISED
  PAID
}

model Offer {
  id          String  @id @default(cuid())
  societyId   String
  vendorId    String
  category    String
  title       String
  description String?

  /// Major units (rupees), pre-discount — matches Payment.amount's convention.
  unitPrice      Decimal @db.Decimal(14, 2)
  /// Non-empty array of {minN: number, pct: number}, validated by
  /// discount-ladder.util.ts's validateLadder (strictly increasing minN,
  /// non-decreasing pct, no duplicates) before this row is ever written.
  discountLadder Json
  /// Snapshotted from discountLadder's lowest rung at creation time — the
  /// commitment count that auto-fires this offer.
  minCommitments Int

  deadline DateTime
  status   OfferStatus @default(OPEN)

  /// Snapshotted at fire time — the ladder tier resolved for the
  /// commitment count that triggered auto-fire. Null until fired.
  appliedDiscountPct Decimal?  @db.Decimal(5, 2)
  firedAt            DateTime?

  /// Phase 4D: SMALL (Phase 4C's single-payout flow, default/unchanged) or
  /// LARGE (milestone + defect-retention flow). Snapshotted onto the Booking
  /// and every JobCard at fire time.
  tier              JobCardTier @default(SMALL)
  /// LARGE only: non-empty array of {name: string, pct: number>0} whose pcts
  /// sum to exactly 100 — validated by milestone-template.util.ts's
  /// validateMilestoneTemplate before this row is ever written. Null for
  /// SMALL offers.
  milestoneTemplate Json?
  /// LARGE only: the defect-liability retention share of the escrowed total,
  /// held back (BULK_BUY -> RETENTION) at the first milestone authorisation.
  /// 0 (and ignored) for SMALL offers.
  retentionPct      Decimal     @default(0) @db.Decimal(5, 2)
  /// LARGE only: days after firing before the retention share may be
  /// released (RETENTION -> EXTERNAL). Null for SMALL offers, or a LARGE
  /// offer with no defect-liability period.
  retentionDays     Int?

  /// Phase 5: NONE (default) or WEEKLY — see OfferRecurrence's doc comment.
  recurring OfferRecurrence @default(NONE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society     Society      @relation(fields: [societyId], references: [id], onDelete: Cascade)
  vendor      Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  commitments Commitment[]

  @@index([societyId, status])
  @@map("offers")
}

/// A resident's financial commitment to either an Offer (Flow A) or a
/// ServiceRequest (Flow B) — exactly one of offerId/serviceRequestId is set,
/// never both and never neither; enforced in application code
/// (BulkBuyService), not a DB constraint (Prisma has no portable
/// CHECK-constraint support here). Not anonymous — this is a financial
/// commitment.
model Commitment {
  id               String           @id @default(cuid())
  /// Flow A (vendor-initiated Offer). Null for a Flow B (service-request-sourced) commitment.
  offerId          String?
  /// Flow B (resident-initiated, tagged-vendor ServiceRequest). Null for a Flow A (offer-sourced) commitment.
  serviceRequestId String?
  residentId       String
  flatId           String
  status           CommitmentStatus @default(PENDING)
  /// The escrow-in Payment (Phase 4B) created for this commitment at fire
  /// time — see BulkBuyService.commit's fire branch. Null until fired.
  paymentId        String?
  createdAt        DateTime         @default(now())

  offer          Offer?          @relation(fields: [offerId], references: [id], onDelete: Cascade)
  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  resident       User            @relation(fields: [residentId], references: [id], onDelete: Cascade)
  flat           Flat            @relation(fields: [flatId], references: [id], onDelete: Cascade)
  jobCard        JobCard?

  @@unique([offerId, residentId])
  @@unique([serviceRequestId, residentId])
  @@index([offerId])
  @@index([serviceRequestId])
  @@map("commitments")
}

/// One Booking per fired Offer in Flow A (sourceType = 'OFFER', sourceId =
/// the Offer's id) — sourceType/sourceId are a loose pointer rather than an
/// FK, matching LedgerEntry.linkedEntityType's pattern, so a later phase
/// (Phase 5 resident-initiated bulk-buy) can reuse Booking/JobCard/Payout
/// against a Poll instead of an Offer without a schema change.
model Booking {
  id         String        @id @default(cuid())
  societyId  String
  vendorId   String
  sourceType String
  sourceId   String
  status     BookingStatus @default(ACTIVE)
  tier       JobCardTier   @default(SMALL)
  createdAt  DateTime      @default(now())

  /// LARGE only. Snapshotted from Offer.retentionPct * escrowed total at the
  /// FIRST milestone authorisation (0 until then, and unused for SMALL).
  retentionAmount     Decimal   @default(0) @db.Decimal(14, 2)
  /// LARGE only. Set at fire time from Offer.retentionDays (null if the
  /// offer set no defect-liability period). Retention cannot be released
  /// before Clock.now() reaches this timestamp.
  retentionReleaseAt  DateTime?
  /// LARGE only. Set once POST /bookings/:id/retention/release succeeds —
  /// its presence is this booking's idempotency guard for that route.
  retentionReleasedAt DateTime?
  /// LARGE only. Flips true the first time a milestone is authorised on this
  /// booking, marking that the once-only retention set-aside
  /// (BULK_BUY -> RETENTION) has already happened — every later milestone
  /// authorisation skips it.
  retentionSetAside   Boolean   @default(false)

  society    Society     @relation(fields: [societyId], references: [id], onDelete: Cascade)
  vendor     Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  jobCards   JobCard[]
  payout     Payout?
  milestones Milestone[]

  @@index([societyId])
  @@map("bookings")
}

model JobCard {
  id                 String        @id @default(cuid())
  bookingId          String
  commitmentId       String
  residentId         String
  flatId             String
  scope              String
  /// Discounted price snapshot (offer.unitPrice * (1 - appliedDiscountPct/100),
  /// rounded to 2dp) — what this resident actually owes.
  unitPrice          Decimal       @db.Decimal(14, 2)
  appliedDiscountPct Decimal       @db.Decimal(5, 2)
  status             JobCardStatus @default(PENDING)
  tier               JobCardTier   @default(SMALL)
  signedOffAt        DateTime?
  createdAt          DateTime      @default(now())

  booking    Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  commitment Commitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  resident   User       @relation(fields: [residentId], references: [id], onDelete: Cascade)
  flat       Flat       @relation(fields: [flatId], references: [id], onDelete: Cascade)

  @@unique([commitmentId])
  @@index([bookingId])
  @@map("job_cards")
}

/// One Payout per Booking in Flow A (4C doesn't support partial/staged
/// payouts — that's 4D's milestone model).
model Payout {
  id                String       @id @default(cuid())
  bookingId         String       @unique
  /// The full escrowed total, paid to the vendor in full. No commission is
  /// split out (V2.0, invariant I2).
  amount            Decimal      @db.Decimal(14, 2)
  status            PayoutStatus @default(PENDING)
  /// The STUBBED RazorpayService.payout() reference — see its doc comment.
  /// Never a real RazorpayX transfer id in this phase.
  razorpayPayoutRef String?
  paidAt            DateTime?
  createdAt         DateTime     @default(now())

  booking        Booking               @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  authorisations PayoutAuthorisation[]

  @@map("payouts")
}

/// Phase 6.4 (BACKEND_PLAN.md Phase 6.4, M14) rework: one row per DISTINCT
/// human officer (TREASURER/DEPUTY_TREASURER/COMMITTEE) who has authorised
/// this Payout — keyed by authoriserId instead of the old SYSTEM/TREASURER
/// `kind` pair, so the SAME identity physically cannot be counted twice
/// (`@@unique([payoutId, authoriserId])`, belt-and-suspenders with the
/// explicit upsert-based no-op in BulkBuyService.authorisePayout). The old
/// automated SYSTEM row is gone — the rule-check it stood for (every job
/// card signed off, every commitment funded, escrow covers the amount) is
/// still enforced on every call, it just isn't persisted as an
/// authorisation any more, because a rung is about DISTINCT HUMAN officers
/// (see BulkBuyService.authorisePayout's doc comment for the full ladder).
model PayoutAuthorisation {
  id           String   @id @default(cuid())
  payoutId     String
  authoriserId String
  createdAt    DateTime @default(now())

  payout Payout @relation(fields: [payoutId], references: [id], onDelete: Cascade)

  @@unique([payoutId, authoriserId])
  @@map("payout_authorisations")
}

/// Phase 4D — one row per template entry, created (all PENDING, in
/// sequence order) when a LARGE offer fires. Mirrors Payout's role for
/// SMALL bookings, but there are many per Booking instead of one, and they
/// must be authorised strictly in sequence order — see
/// BulkBuyService.authoriseMilestone.
model Milestone {
  id                String       @id @default(cuid())
  bookingId         String
  /// 1-based release order, snapshotted from the offer's milestoneTemplate
  /// array index at fire time.
  sequence          Int
  name              String
  /// Share of vendorPayable (escrowed total minus retention) this
  /// milestone releases. The template's pcts sum to 100,
  /// but the LAST milestone by sequence always releases whatever remains of
  /// vendorPayable rather than exactly amount*pct/100, to avoid rounding
  /// dust — see authoriseMilestone's doc comment.
  pct               Decimal      @db.Decimal(5, 2)
  status            PayoutStatus @default(PENDING)
  /// Snapshotted the moment this milestone is released (null until PAID).
  amount            Decimal?     @db.Decimal(14, 2)
  paidAt            DateTime?
  /// The STUBBED RazorpayService.payout() reference — never a real
  /// RazorpayX transfer id in this phase (see Payout.razorpayPayoutRef).
  razorpayPayoutRef String?
  createdAt         DateTime     @default(now())

  booking        Booking                  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  authorisations MilestoneAuthorisation[]

  @@unique([bookingId, sequence])
  @@index([bookingId])
  @@map("milestones")
}

/// Phase 6.4 rework — same distinct-officer shape as PayoutAuthorisation
/// (see its doc comment), just scoped to one Milestone instead of one
/// Payout.
model MilestoneAuthorisation {
  id           String   @id @default(cuid())
  milestoneId  String
  authoriserId String
  createdAt    DateTime @default(now())

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@unique([milestoneId, authoriserId])
  @@map("milestone_authorisations")
}
